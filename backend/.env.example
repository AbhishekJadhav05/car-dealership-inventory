# Copy this file to .env and fill in the values.
# Never commit .env — it is gitignored.

# Dev database (running locally via Docker on port 5433)
DATABASE_URL=postgresql+psycopg://dealership:dealership@localhost:5433/dealership

# Test database — used by pytest when TEST_DATABASE_URL is set.
# In CI, DATABASE_URL already points at dealership_test so this is optional there.
TEST_DATABASE_URL=postgresql+psycopg://dealership:dealership@localhost:5433/dealership_test

# JWT — change this to a long random string in any non-dev environment.
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
